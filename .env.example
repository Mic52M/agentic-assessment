# --- agentic-assessment configuration ---
# Copy to `.env` and adjust. All values have safe defaults; the prototype
# runs with no .env at all (no cloud service is required).

# Directory where structured run traces are written.
RUNS_DIR=runs

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Anthropic API key — required for the LLM-backed agent (the default).
# Without it, the system automatically falls back to the deterministic
# rule-based stand-ins, so the prototype still runs offline.
ANTHROPIC_API_KEY=

# Master switch for the LLM nodes. Default true: planner/executor/verifier are
# Claude-driven. Set false to force the offline, deterministic rule-based path
# — useful for reproducible baseline experiments and the test suite.
LLM_ENABLED=true

# Which Claude model to call when LLM_ENABLED=true. Treat as an experimental
# condition: changing it does not require code changes; the trace records
# the exact id and the derived per-call cost.
LLM_MODEL=claude-opus-4-7

# Emit OpenTelemetry spans in addition to JSON traces.
# Only effective if opentelemetry-sdk is installed; otherwise ignored.
OTEL_ENABLED=false

# --- Fault model (robustness / availability experiments) ---
# Three independent families, each in [0.0, 1.0]. Overridable per-run.
#
# crash:  probability that a tool call raises.
TOOL_FAILURE_RATE=0.0
# slow:   probability of injecting latency, and the latency in ms when it fires.
TOOL_SLOW_RATE=0.0
TOOL_SLOW_MS=0.0
# corrupt: probability of replacing the classifier's output with a
#          syntactically-valid but semantically-wrong category.
TOOL_CORRUPT_RATE=0.0
